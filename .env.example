# ==========================================
# MacroSentinel Configuration Environment
# ==========================================

# Federal Reserve Economic Data (FRED) API Key
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Bureau of Labor Statistics (BLS) API Key (Optional, increases rate limits)
# Get a free key at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# CFTC SODA2 App Token (Optional, public access works without key)
CFTC_APP_TOKEN=

# LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini/gemini-1.5-flash

# Telegram Dispatcher (Optional for alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Dispatcher (Optional for SMTP / Resend)
RESEND_API_KEY=
ALERT_EMAIL_RECIPIENT=

# Scheduler Configuration (Cron format or hours)
# Format: minute hour day month day-of-week
SCAN_CRON_SCHEDULE="0 8 * * 1-5"  # Every weekday at 08:00 AM
DATA_STORAGE_DIR="./data"
